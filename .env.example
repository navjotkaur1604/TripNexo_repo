# Application Environment
NODE_ENV=development
PORT=5000
GATEWAY_PORT=5000

# MongoDB Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/tripnexo

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Redis Caching (Optional: falls back gracefully if unavailable)
REDIS_URL=redis://127.0.0.1:6379
REDIS_TTL_SECONDS=300

# Microservices Internal URLs (Service Discovery via Docker Compose or localhost)
AUTH_SERVICE_URL=http://127.0.0.1:5001
DESTINATION_SERVICE_URL=http://127.0.0.1:5002
TRIP_SERVICE_URL=http://127.0.0.1:5003
BUDGET_SERVICE_URL=http://127.0.0.1:5004

AUTH_SERVICE_PORT=5001
DESTINATION_SERVICE_PORT=5002
TRIP_SERVICE_PORT=5003
BUDGET_SERVICE_PORT=5004

# Frontend Client Origin & API Gateway URL
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# File Upload & Cloud Storage Adapter ('local' or 's3')
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=2

# Optional S3-Compatible Cloud Storage Credentials (required only when STORAGE_DRIVER=s3)
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=ap-south-1
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=
